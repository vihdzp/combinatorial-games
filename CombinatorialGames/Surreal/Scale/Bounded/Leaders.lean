module

public import CombinatorialGames.Surreal.Scale.Bounded.Basic
public import CombinatorialGames.Surreal.Scale.MonoidAlgebra
public import Mathlib.Algebra.Order.Monoid.Submonoid

import Mathlib.Tactic.TypeStar

/-!
# The ring generated by bounded scale leaders

Finite sums of bounded nonnegative leaders form the monoid ring on the nonnegative cone of the
bounded precision group. This ring is closed under bounded rounding.
-/

universe u

public noncomputable section

namespace Surreal

variable (i : Surreal.{u})

local notation "C" => lowerGrowthSubring i
local notation "K" => residueSubfield C
local notation "V" => boundedResidueRepresentatives i
local notation "M" => AddSubmonoid.nonneg (boundedPrecisionGroup i)

/-- The underlying surreal exponent of a nonnegative bounded precision. -/
abbrev boundedExponent : M →+ Surreal.{u} :=
  (boundedPrecisionGroup i).subtype.comp (AddSubmonoid.nonneg (boundedPrecisionGroup i)).subtype

private theorem boundedExponent_mem (t : M) : boundedExponent i t ∈ boundedPrecision i :=
  (mem_boundedPrecision_iff_nonneg i).mpr ⟨t.2, t.1.2⟩

private abbrev boundedIndex {t : Surreal.{u}} (ht : t ∈ boundedPrecision i) : M :=
  ⟨⟨t, ((mem_boundedPrecision_iff_nonneg i).mp ht).2⟩,
    ((mem_boundedPrecision_iff_nonneg i).mp ht).1⟩

/-- Finite sums of nonnegative bounded leaders with residue coefficients, evaluated as
bounded surreal numbers. -/
def boundedLeaderEvaluation : AddMonoidAlgebra K M →+* V :=
  (leaderEvaluation C (boundedExponent i)).codRestrict V fun p ↦ by
    rw [leaderEvaluation_apply]
    apply (boundedResidueRepresentatives i).sum_mem
    intro t _
    have hk := (algebraMap K V (p.coeff t)).2
    rw [coe_boundedResidue_algebraMap] at hk
    exact (boundedResidueRepresentatives i).mul_mem hk
      (wpow_mem_boundedResidueRepresentatives i (boundedExponent_mem i t))

theorem coe_boundedLeaderEvaluation (p : AddMonoidAlgebra K M) :
    (boundedLeaderEvaluation i p : Surreal) = leaderEvaluation C (boundedExponent i) p := (rfl)

theorem boundedLeaderEvaluation_injective : Function.Injective (boundedLeaderEvaluation i) := by
  intro a b hab
  apply leaderEvaluation_injective C (boundedExponent i) (fun _ _ h ↦ h)
    (fun t ↦ ((mem_boundedPrecisionGroup i).mp t.1.2).1)
  exact congrArg Subtype.val hab

/-- Finite sums of leaders with nonnegative bounded exponent and residue-field coefficients. -/
def boundedLeaderSubring : Subring V := (boundedLeaderEvaluation i).range

theorem mem_boundedLeaderSubring {x : V} :
    x ∈ boundedLeaderSubring i ↔ ∃ p, boundedLeaderEvaluation i p = x := Iff.rfl

/-- The nonnegative monoid algebra is the ring of finite sums of bounded leaders. -/
def boundedLeaderEquiv : AddMonoidAlgebra K M ≃+* boundedLeaderSubring i :=
  RingEquiv.ofBijective (boundedLeaderEvaluation i).rangeRestrict
    ⟨fun _ _ h ↦ boundedLeaderEvaluation_injective i (congrArg Subtype.val h),
      (boundedLeaderEvaluation i).rangeRestrict_surjective⟩

private theorem boundedLeaderEvaluation_single (t : M) (k : K) :
    boundedLeaderEvaluation i (AddMonoidAlgebra.single t k) =
      algebraMap K V k * boundedMonomial i (boundedExponent_mem i t) := by
  apply Subtype.ext
  rw [coe_boundedLeaderEvaluation, leaderEvaluation_single, Subring.coe_mul,
    coe_boundedResidue_algebraMap, coe_boundedMonomial]

theorem boundedMonomial_mem_boundedLeaderSubring {t : Surreal.{u}} (ht : t ∈ boundedPrecision i) :
    boundedMonomial i ht ∈ boundedLeaderSubring i := by
  apply (mem_boundedLeaderSubring i).2
  exact ⟨AddMonoidAlgebra.single (boundedIndex i ht) 1, by
    rw [boundedLeaderEvaluation_single, map_one, one_mul]; rfl⟩

theorem algebraMap_mem_boundedLeaderSubring (k : K) :
    algebraMap K V k ∈ boundedLeaderSubring i := by
  apply (mem_boundedLeaderSubring i).2
  refine ⟨AddMonoidAlgebra.single 0 k, Subtype.ext ?_⟩
  rw [coe_boundedLeaderEvaluation, leaderEvaluation_single, map_zero, wpow_zero, mul_one,
    coe_boundedResidue_algebraMap]

private theorem boundedLeaderEvaluation_sum (p : AddMonoidAlgebra K M) :
    boundedLeaderEvaluation i p = ∑ m ∈ p.coeff.support,
      algebraMap K V (p.coeff m) * boundedMonomial i (boundedExponent_mem i m) := by
  apply Subtype.ext
  rw [coe_boundedLeaderEvaluation, leaderEvaluation_apply]
  change _ = (boundedResidueRepresentatives i).subtype (∑ m ∈ p.coeff.support, _)
  rw [map_sum]
  simp only [Subring.subtype_apply, Subring.coe_mul, coe_boundedResidue_algebraMap,
    coe_boundedMonomial]

/-- Rescaled rounding sends finite sums of scale leaders to finite sums of scale leaders. -/
theorem boundedRound_mem_boundedLeaderSubring {t : Surreal.{u}} (ht : t ∈ boundedPrecision i)
    {x : V} (hx : x ∈ boundedLeaderSubring i) :
    boundedRound i ((mem_boundedPrecision i).mp ht).1 x ∈ boundedLeaderSubring i := by
  classical
  obtain ⟨ht₀, htfix, -⟩ := (mem_boundedPrecision i).mp ht
  obtain ⟨p, rfl⟩ := (mem_boundedLeaderSubring i).mp hx
  let T : V →+ V :=
    { toFun := boundedRound i ht₀
      map_zero' := Subtype.ext (by simp [coe_boundedRound, roundAt_eq])
      map_add' := fun x y ↦ Subtype.ext (by
        simp only [coe_boundedRound, Subring.coe_add, roundAt_add]) }
  change T (boundedLeaderEvaluation i p) ∈ _
  rw [boundedLeaderEvaluation_sum, map_sum]
  apply (boundedLeaderSubring i).sum_mem
  intro m _
  let s := boundedExponent i m
  have hs : s ∈ boundedPrecision i := boundedExponent_mem i m
  let k := p.coeff m
  change T (algebraMap K V k * boundedMonomial i hs) ∈ _
  rcases le_or_gt t s with hts | hst
  · have hd := sub_mem_boundedPrecision i ht hs hts
    have he : T (algebraMap K V k * boundedMonomial i hs) =
        algebraMap K V k * boundedMonomial i hd := by
      apply Subtype.ext
      change (boundedRound i ht₀ _ : Surreal) = _
      rw [coe_boundedRound, Subring.coe_mul, coe_boundedMonomial, coe_boundedResidue_algebraMap,
        Subring.coe_mul, coe_boundedMonomial, coe_boundedResidue_algebraMap]
      exact roundAt_mul_wpow_of_le C hts k
    exact he ▸ (boundedLeaderSubring i).mul_mem (algebraMap_mem_boundedLeaderSubring i k)
      (boundedMonomial_mem_boundedLeaderSubring i hd)
  · have he : T (algebraMap K V k * boundedMonomial i hs) = 0 := by
      apply Subtype.ext
      change (boundedRound i ht₀ _ : Surreal) = 0
      rw [coe_boundedRound, Subring.coe_mul, coe_boundedMonomial, coe_boundedResidue_algebraMap]
      exact roundAt_mul_wpow_eq_zero C hst ((mem_boundedPrecision i).mp hs).2.1 htfix k
    exact he ▸ (boundedLeaderSubring i).zero_mem

end Surreal
