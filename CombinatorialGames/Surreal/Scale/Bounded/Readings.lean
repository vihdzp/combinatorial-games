module

public import CombinatorialGames.Surreal.Scale.Bounded.Leaders
public import Mathlib.RingTheory.AlgebraicIndependent.Defs

public import CombinatorialGames.Mathlib.Polynomial.OrderedReadings
import CombinatorialGames.Surreal.Scale.Bounded.Adjunction
import CombinatorialGames.Surreal.Scale.RoundedProduct
import CombinatorialGames.Surreal.Scale.Bounded.Recovery

/-!
# Independent readings of bounded representatives

Each new reading whose predecessors cannot express it is transcendental over them.
The first missing precision proves that the selected readings generate every input entry.
-/

universe u

open Set

public noncomputable section

namespace Surreal

variable (i : Surreal.{u})

local notation "C" => lowerGrowthSubring i
local notation "V" => boundedResidueRepresentatives i
local notation "B" => boundedLeaderSubring i

private theorem boundedRound_mul_mem (E : Subring V)
    (hm : ∀ {r : Surreal.{u}} (hr : r ∈ boundedPrecision i), boundedMonomial i hr ∈ E)
    (x y : V)
    (hx : ∀ {r : Surreal.{u}} (hr : r ∈ boundedPrecision i),
      boundedRound i ((mem_boundedPrecision i).mp hr).1 x ∈ E)
    (hy : ∀ {r : Surreal.{u}} (hr : r ∈ boundedPrecision i),
      boundedRound i ((mem_boundedPrecision i).mp hr).1 y ∈ E)
    {t : Surreal.{u}} (ht : t ∈ boundedPrecision i) :
    boundedRound i ((mem_boundedPrecision i).mp ht).1 (x * y) ∈ E := by
  let F := E.map (V).subtype
  obtain ⟨ht₀, htfix, _, _⟩ := (mem_boundedPrecision i).mp ht
  have hgen : roundedProductGenerators C t x y ⊆ F := by
    intro a ha
    obtain ⟨r, hr, hrfix, rfl | rfl | rfl⟩ := (mem_roundedProductGenerators C).mp ha
    all_goals
      have hprec := mem_boundedPrecision_of_le i hr.1 hrfix hr.2 ht
    · exact Subring.mem_map.mpr ⟨_, hm hprec, coe_boundedMonomial i hprec⟩
    · exact Subring.mem_map.mpr ⟨_, hx hprec, coe_boundedRound i hr.1 x⟩
    · exact Subring.mem_map.mpr ⟨_, hy hprec, coe_boundedRound i hr.1 y⟩
  have hrounded := roundAt_mul_mem_closure C ht₀ htfix x y
    ((mem_boundedResidueRepresentatives i).mp x.2).1
    ((mem_boundedResidueRepresentatives i).mp y.2).1
  obtain ⟨a, ha, heq⟩ := Subring.mem_map.mp (Subring.closure_le.mpr hgen hrounded)
  have h : a = boundedRound i ht₀ (x * y) :=
    Subtype.ext (heq.trans (coe_boundedRound i ht₀ (x * y)).symm)
  exact h ▸ ha

/-- A polynomial algebra generated by readings stays closed under rounding if the
readings of its generators already lie in the algebra. -/
theorem boundedRound_mem_adjoin_of_readings (D : Set V)
    (hD : ∀ y ∈ D, ∀ t (ht : t ∈ boundedPrecision i),
      boundedRound i ((mem_boundedPrecision i).mp ht).1 y ∈ Algebra.adjoin B D)
    {t : Surreal.{u}} (ht : t ∈ boundedPrecision i) {y : V} (hy : y ∈ Algebra.adjoin B D) :
    boundedRound i ((mem_boundedPrecision i).mp ht).1 y ∈ Algebra.adjoin B D := by
  let E := Algebra.adjoin B D
  have hm {r : Surreal.{u}} (hr : r ∈ boundedPrecision i) : boundedMonomial i hr ∈ E.toSubring :=
    E.algebraMap_mem (⟨_, boundedMonomial_mem_boundedLeaderSubring i hr⟩ : B)
  induction hy using Algebra.adjoin_induction generalizing t with
  | mem y hy => exact hD y hy _ ht
  | algebraMap b =>
    exact E.algebraMap_mem (⟨_, boundedRound_mem_boundedLeaderSubring i ht b.2⟩ : B)
  | add x y _ _ hx hy =>
    have he : boundedRound i ((mem_boundedPrecision i).mp ht).1 (x + y) =
        boundedRound i ((mem_boundedPrecision i).mp ht).1 x +
          boundedRound i ((mem_boundedPrecision i).mp ht).1 y :=
      Subtype.ext (by simpa only [coe_boundedRound, Subring.coe_add] using roundAt_add C t x y)
    rw [he]
    exact E.add_mem (hx ht) (hy ht)
  | mul x y _ _ hx hy => exact boundedRound_mul_mem i E.toSubring hm x y hx hy ht

/-- Rescaled prefixes of an indexed family of bounded representatives. -/
abbrev boundedReadings {ι : Type*} (z : ι → V) (j : ι) (t : boundedPrecision i) : V :=
  boundedRound i ((mem_boundedPrecision i).mp t.2).1 (z j)

/-- The readings selected in entry order are independent and span every reading of every entry. -/
theorem independent_bounded_readings {ι : Type*} [LinearOrder ι] [WellFoundedLT ι] (z : ι → V) :
    let v := boundedReadings i z
    AlgebraicIndependent B ((↑) : Algebra.selectedReadings B v → V) ∧
      ∀ j t, v j t ∈ Algebra.adjoin B (Algebra.selectedReadings B v) := by
  intro v
  have hm (E : Subalgebra B V) {r : Surreal.{u}} (hr : r ∈ boundedPrecision i) :
      boundedMonomial i hr ∈ E.toSubring :=
    E.algebraMap_mem (⟨_, boundedMonomial_mem_boundedLeaderSubring i hr⟩ : B)
  have hrigid (j : ι) (t : boundedPrecision i) :
      let E := Algebra.adjoin B (Algebra.earlierReadings v j t)
      v j t ∉ E → Transcendental E (v j t) := by
    intro E hnew
    have earlier {k : ι} {s : boundedPrecision i} (hs : k < j ∨ k = j ∧ t < s) :
        v k s ∈ E := Algebra.subset_adjoin (Algebra.mem_earlierReadings.mpr ⟨k, s, hs, rfl⟩)
    have hD : ∀ a ∈ Algebra.earlierReadings v j t, ∀ r (hr : r ∈ boundedPrecision i),
        boundedRound i ((mem_boundedPrecision i).mp hr).1 a ∈ E := by
      intro a ha r hr
      obtain ⟨k, s, hs, rfl⟩ := Algebra.mem_earlierReadings.mp ha
      dsimp only [v, boundedReadings]
      rw [boundedRound_boundedRound]
      exact earlier (s := ⟨s + r, add_mem_boundedPrecision i s.2 hr⟩)
        (hs.imp_right fun ⟨he, hlt⟩ ↦ ⟨he, hlt.trans_le
          (le_add_of_nonneg_right ((mem_boundedPrecision i).mp hr).1)⟩)
    apply transcendental_boundedRound_of_pos_readings i E (fun hr _ ha ↦
      boundedRound_mem_adjoin_of_readings i _ hD hr ha) _ hnew
    intro r hr hp
    dsimp only [v, boundedReadings]
    rw [boundedRound_boundedRound]
    exact earlier (s := ⟨t + r, add_mem_boundedPrecision i t.2 hr⟩)
      (Or.inr ⟨rfl, lt_add_of_pos_right _ hp⟩)
  have hfirst (E : Subalgebra B V) (j : ι) (h : ∃ t, v j t ∉ E) :
      ∃ t, v j t ∉ E ∧ ∀ s, t < s → v j s ∈ E := by
    obtain ⟨t, hbad⟩ := h
    obtain ⟨s, hs, hout, hmax⟩ := exists_greatest_missing_boundedRound i E.toSubring
      (hm E) (z j) ⟨t, t.2, hbad⟩
    exact ⟨⟨s, hs⟩, hout, fun r hr ↦ by_contra fun h ↦ hr.not_ge (hmax r r.2 h)⟩
  exact Algebra.independent_ordered_readings v Subtype.val_injective hrigid hfirst

end Surreal
