module

public import CombinatorialGames.Surreal.Scale.Bounded.Readings

import CombinatorialGames.Mathlib.Polynomial.OrderedReadings
import Mathlib.SetTheory.Cardinal.Order

/-!
# A polynomial presentation of all bounded representatives
-/

universe u

public noncomputable section

namespace Surreal

variable (i : Surreal.{u})

local notation "V" => boundedResidueRepresentatives i
local notation "B" => boundedLeaderSubring i

/-- The bounded residue representatives form a polynomial algebra over the ring generated by
bounded leaders and residue scalars. -/
theorem exists_mvPolynomial_algEquiv_boundedResidueRepresentatives :
    ∃ σ : Type (u + 1), Nonempty (MvPolynomial σ B ≃ₐ[B] V) := by
  obtain ⟨ord, wf⟩ := exists_wellFoundedLT (↥V)
  obtain ⟨hind, hall⟩ := independent_bounded_readings i (id : V → V)
  exact ⟨_, ⟨hind.mvPolynomialAlgEquivOfAdjoinEqTop (top_unique fun z _ ↦ by
    simpa only [boundedReadings, id_eq, boundedRound_zero] using
      hall z ⟨0, zero_mem_boundedPrecision i⟩)⟩⟩

end Surreal
