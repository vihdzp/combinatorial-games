module

public import CombinatorialGames.Surreal.Scale.Rounding

/-!
# Products of rounded surreal numbers

At a fixed precision, the rounding of a product lies in the subring generated by the
rescaled roundings of its factors and the corresponding Conway monomials at precisions up to
the given one.
-/

universe u

open Set
open scoped IGame Pointwise

public noncomputable section

namespace Surreal

private theorem exists_weakly_between_small_sets (s t : Set Surreal.{u})
    [Small.{u} s] [Small.{u} t] (h : ∀ a ∈ s, ∀ b ∈ t, a ≤ b) :
    ∃ x : Surreal.{u}, (∀ a ∈ s, a ≤ x) ∧ ∀ b ∈ t, x ≤ b := by
  by_cases hx : ∃ x ∈ s, x ∈ t
  · obtain ⟨x, hxs, hxt⟩ := hx
    exact ⟨x, fun a ha ↦ h a ha x hxt, fun b hb ↦ h x hxs b hb⟩
  · have hsep (a : Surreal.{u}) (ha : a ∈ s) (b : Surreal.{u}) (hb : b ∈ t) : a < b :=
      (h a ha b hb).lt_of_ne fun e ↦ hx ⟨a, ha, e ▸ hb⟩
    exact ⟨!{s | t}' hsep, fun _ ha ↦ (lt_ofSets_of_mem_left ha).le,
      fun _ hb ↦ (ofSets_lt_of_mem_right hb).le⟩

private theorem cosetRep_half_eq {A : AddSubgroup Surreal.{u}} [A.IsConvex]
    {x : Surreal.{u}} (hx : cosetRep A x = x) : cosetRep A (x / 2) = x / 2 := by
  have h : x / 2 + x / 2 = x := by ring
  have h' : cosetRep A (x / 2) + cosetRep A (x / 2) = x := by
    rw [← cosetRep_add, h, hx]
  linarith only [h, h']

variable (C : Subring Surreal.{u}) [C.toAddSubgroup.IsConvex]

local notation "A" => unitExponentSubgroup C
local notation "B" => infinitesimals C
local notation "U" => residueRepresentatives C
local notation "D[" t "]" => (ω^ (t : Surreal) • infinitesimals C)

private theorem scaledInfinitesimals_zero : D[0] = B := by
  rw [wpow_zero, one_smul]

private theorem gap_ne_zero {x a : Surreal.{u}} (ha : a.birthday < x.birthday) : x - a ≠ 0 :=
  sub_ne_zero.mpr fun e ↦ ha.ne (congrArg birthday e.symm)

private theorem precisionLevel_gap_nonneg {x a : Surreal.{u}} (hx : x ∈ U)
    (ha : a.birthday < x.birthday) : 0 ≤ precisionLevel C (x - a) := by
  by_contra! h
  have hm := (mem_wpow_smul_infinitesimals_iff C (gap_ne_zero ha) (cosetRep_zero A)).mpr h
  rw [scaledInfinitesimals_zero] at hm
  exact cosetRep_eq_iff.mp ((mem_residueRepresentatives_iff C).mp hx) a ha hm

private theorem rounding_of_prefix_mem {s x r t : Surreal.{u}} (hs : s ∈ Icc 0 t)
    (hsfix : cosetRep A s = s) (hr : r ∈ Icc 0 t) (hrfix : cosetRep A r = r)
    {S : Subring Surreal.{u}}
    (hm : ∀ v ∈ Icc (0 : Surreal.{u}) t, cosetRep A v = v → ω^ v ∈ S)
    (hround : ∀ v ∈ Icc (0 : Surreal.{u}) t, cosetRep A v = v → roundAt C v x ∈ S) :
    roundAt C r (cosetRep D[s] x) ∈ S := by
  rcases le_total s r with hsr | hrs
  · rw [roundAt_scaleCosetRep_of_le C hsr]
    exact hround r hr hrfix
  · have hdiff : s - r ∈ Icc 0 t := ⟨sub_nonneg.mpr hrs, (sub_le_self _ hr.1).trans hs.2⟩
    have hdiffFix : cosetRep A (s - r) = s - r := by rw [cosetRep_sub, hsfix, hrfix]
    rw [roundAt_scaleCosetRep_of_ge C hrs]
    exact S.mul_mem (hm _ hdiff hdiffFix) (hround s hs hsfix)

/-- The monomials and the rescaled roundings of two surreals at precisions from zero to `t`. -/
def roundedProductGenerators (t x y : Surreal.{u}) : Set Surreal.{u} :=
  {a | ∃ r ∈ Icc 0 t, cosetRep A r = r ∧
    (a = ω^ r ∨ a = roundAt C r x ∨ a = roundAt C r y)}

/-- Membership in the set of generators for rounding a product at precision `t`. -/
theorem mem_roundedProductGenerators {t x y a : Surreal.{u}} :
    a ∈ roundedProductGenerators C t x y ↔ ∃ r ∈ Icc 0 t, cosetRep A r = r ∧
      (a = ω^ r ∨ a = roundAt C r x ∨ a = roundAt C r y) :=
  Iff.rfl

private theorem roundedProductGenerators_closure_le {t x y : Surreal.{u}} {S : Subring Surreal.{u}}
    (hm : ∀ r ∈ Icc (0 : Surreal.{u}) t, cosetRep A r = r → ω^ r ∈ S)
    (hx : ∀ r ∈ Icc (0 : Surreal.{u}) t, cosetRep A r = r → roundAt C r x ∈ S)
    (hy : ∀ r ∈ Icc (0 : Surreal.{u}) t, cosetRep A r = r → roundAt C r y ∈ S) :
    Subring.closure (roundedProductGenerators C t x y) ≤ S := by
  apply Subring.closure_le.mpr
  rintro a ⟨r, hr, hfix, rfl | rfl | rfl⟩
  · exact hm r hr hfix
  · exact hx r hr hfix
  · exact hy r hr hfix

/-- Rounding a product at precision `t` is a ring expression in the monomials and the
roundings of the two factors at precisions between zero and `t`. -/
theorem roundAt_mul_mem_closure {t : Surreal.{u}} (ht : 0 ≤ t) (htfix : cosetRep A t = t) :
    ∀ x y : Surreal.{u}, x ∈ U → y ∈ U →
      roundAt C t (x * y) ∈ Subring.closure (roundedProductGenerators C t x y) := by
  let claim (x y : Surreal.{u}) : Prop := x ∈ U → y ∈ U →
    roundAt C t (x * y) ∈ Subring.closure (roundedProductGenerators C t x y)
  change ∀ x y, claim x y
  intro x
  refine (InvImage.wf birthday wellFounded_lt).induction (C := fun x ↦ ∀ y, claim x y) x ?_
  intro x ihx y
  refine (InvImage.wf birthday wellFounded_lt).induction (C := claim x) y ?_
  intro y ihy hx hy
  let S := Subring.closure (roundedProductGenerators C t x y)
  change roundAt C t (x * y) ∈ S
  have hm r hr hf : ω^ r ∈ S := Subring.subset_closure ⟨r, hr, hf, Or.inl rfl⟩
  have hroundx r hr hf : roundAt C r x ∈ S :=
    Subring.subset_closure ⟨r, hr, hf, Or.inr (Or.inl rfl)⟩
  have hroundy r hr hf : roundAt C r y ∈ S :=
    Subring.subset_closure ⟨r, hr, hf, Or.inr (Or.inr rfl)⟩
  by_cases h : ∃ a : Surreal.{u}, a.birthday < x.birthday ∧
    ∃ b : Surreal.{u}, b.birthday < y.birthday ∧
      precisionLevel C (x - a) + precisionLevel C (y - b) < t
  · obtain ⟨a, ha, b, hb, hab⟩ := h
    let p := (precisionLevel C (x - a) + (t - precisionLevel C (y - b))) / 2
    let q := t - p
    have hpfix : cosetRep A p = p := by
      apply cosetRep_half_eq
      rw [cosetRep_add, cosetRep_sub, cosetRep_precisionLevel, cosetRep_precisionLevel, htfix]
    have hqfix : cosetRep A q = q := by
      dsimp only [q]
      rw [cosetRep_sub, hpfix, htfix]
    have hpa : precisionLevel C (x - a) < p := by dsimp [p]; linarith
    have hqb : precisionLevel C (y - b) < q := by dsimp [q, p]; linarith
    have hp₀ := (precisionLevel_gap_nonneg C hx ha).trans hpa.le
    have hq₀ := (precisionLevel_gap_nonneg C hy hb).trans hqb.le
    have hp : p ∈ Icc 0 t := ⟨hp₀, by linarith [show q = t - p from rfl]⟩
    have hq : q ∈ Icc 0 t := ⟨hq₀, sub_le_self _ hp₀⟩
    have hpq : p + q = t := by dsimp [q]; ring
    let x' := cosetRep D[p] x
    let y' := cosetRep D[q] y
    have hxa : x - a ∈ D[p] :=
      (mem_wpow_smul_infinitesimals_iff C (gap_ne_zero ha) hpfix).mpr hpa
    have hyb : y - b ∈ D[q] :=
      (mem_wpow_smul_infinitesimals_iff C (gap_ne_zero hb) hqfix).mpr hqb
    have hxb : x'.birthday < x.birthday := (birthday_cosetRep_le hxa).trans_lt ha
    have hyb' : y'.birthday < y.birthday := (birthday_cosetRep_le hyb).trans_lt hb
    have hx' := cosetRep_wpow_smul_mem_residueRepresentatives C hp.1 x
    have hy' := cosetRep_wpow_smul_mem_residueRepresentatives C hq.1 y
    have hobsx r hr hf : roundAt C r x' ∈ S :=
      rounding_of_prefix_mem C hp hpfix hr hf hm hroundx
    have hobsy r hr hf : roundAt C r y' ∈ S :=
      rounding_of_prefix_mem C hq hqfix hr hf hm hroundy
    have hxy' : roundAt C t (x * y') ∈ S :=
      roundedProductGenerators_closure_le C hm hroundx hobsy (ihy y' hyb' hx hy')
    have hx'y : roundAt C t (x' * y) ∈ S :=
      roundedProductGenerators_closure_le C hm hobsx hroundy (ihx x' hxb y hx' hy)
    have hx'y' : roundAt C t (x' * y') ∈ S :=
      roundedProductGenerators_closure_le C hm hobsx hobsy (ihx x' hxb y' hx' hy')
    have herr : ((x - x') * (y - y')) / ω^ t ∈ B := by
      rw [← hpq, wpow_add, ← div_mul_div_comm]
      apply mul_mem_infinitesimals_of_mem C
      · exact infinitesimals_le C
          ((mem_smul_addSubgroup_iff_div_mem (wpow_ne_zero p)).mp (sub_cosetRep_mem D[p] x))
      · exact (mem_smul_addSubgroup_iff_div_mem (wpow_ne_zero q)).mp (sub_cosetRep_mem D[q] y)
    have heq : roundAt C t (x * y) = roundAt C t (x' * y + x * y' - x' * y') := by
      simp only [roundAt_eq]
      apply cosetRep_eq_of_sub_mem
      rw [← sub_div, show x * y - (x' * y + x * y' - x' * y') = (x - x') * (y - y') by ring]
      exact herr
    rw [heq]
    simpa only [roundAt_eq, sub_div, add_div, cosetRep_sub, cosetRep_add] using
      S.sub_mem (S.add_mem hx'y hxy') hx'y'
  · let s := (fun b ↦ t - precisionLevel C (y - b)) '' {b | b.birthday < y.birthday}
    let r := (fun a ↦ precisionLevel C (x - a)) '' {a | a.birthday < x.birthday}
    have hs : Small.{u} s := inferInstanceAs (Small.{u}
      ((fun b ↦ t - precisionLevel C (y - b)) '' {b | b.birthday < y.birthday}))
    have hr : Small.{u} r := inferInstanceAs (Small.{u}
      ((fun a ↦ precisionLevel C (x - a)) '' {a | a.birthday < x.birthday}))
    have hsep : ∀ a ∈ s, ∀ b ∈ r, a ≤ b := by
      rintro _ ⟨b, hb, rfl⟩ _ ⟨a, ha, rfl⟩
      have hle := le_of_not_gt fun hab ↦ h ⟨a, ha, b, hb, hab⟩
      linarith
    obtain ⟨z, hzLeft, hzRight⟩ := exists_weakly_between_small_sets s r hsep
    let p := max 0 (min t (cosetRep A z))
    let q := t - p
    have hp : p ∈ Icc 0 t := ⟨le_max_left .., max_le ht (min_le_left ..)⟩
    have hq : q ∈ Icc 0 t := ⟨sub_nonneg.mpr hp.2, sub_le_self t hp.1⟩
    have hpfix : cosetRep A p = p := by
      dsimp [p]
      rw [(monotone_cosetRep A).map_max, (monotone_cosetRep A).map_min,
        cosetRep_zero, htfix, cosetRep_cosetRep]
    have hqfix : cosetRep A q = q := by
      dsimp only [q]
      rw [cosetRep_sub, hpfix, htfix]
    have hpq : p + q = t := by dsimp [q]; ring
    have hxp : cosetRep D[p] x = x := by
      apply cosetRep_eq_iff.mpr
      intro a ha hmem
      have hle : cosetRep A z ≤ precisionLevel C (x - a) := by
        simpa only [cosetRep_precisionLevel] using monotone_cosetRep A (hzRight _ ⟨a, ha, rfl⟩)
      have hnp : p ≤ precisionLevel C (x - a) :=
        max_le (precisionLevel_gap_nonneg C hx ha) ((min_le_right ..).trans hle)
      exact hnp.not_gt ((mem_wpow_smul_infinitesimals_iff C (gap_ne_zero ha) hpfix).mp hmem)
    have hyq : cosetRep D[q] y = y := by
      apply cosetRep_eq_iff.mpr
      intro b hb hmem
      have hle : t - precisionLevel C (y - b) ≤ cosetRep A z := by
        have hmono := monotone_cosetRep A (hzLeft _ ⟨b, hb, rfl⟩)
        rwa [cosetRep_sub, htfix, cosetRep_precisionLevel] at hmono
      have hlt : t - precisionLevel C (y - b) ≤ p :=
        (le_min (sub_le_self t (precisionLevel_gap_nonneg C hy hb)) hle).trans
          (le_max_right ..)
      have hnq : q ≤ precisionLevel C (y - b) := by dsimp [q]; linarith
      exact hnq.not_gt ((mem_wpow_smul_infinitesimals_iff C (gap_ne_zero hb) hqfix).mp hmem)
    have hxRound : roundAt C p x = x / ω^ p := by
      apply (eq_div_iff (wpow_ne_zero _)).mpr
      simpa only [mul_comm (ω^ p), roundAt_eq] using
        (cosetRep_wpow_smul B p x).symm.trans hxp
    have hyRound : roundAt C q y = y / ω^ q := by
      apply (eq_div_iff (wpow_ne_zero _)).mpr
      simpa only [mul_comm (ω^ q), roundAt_eq] using
        (cosetRep_wpow_smul B q y).symm.trans hyq
    have hprod : cosetRep B (roundAt C p x * roundAt C q y) =
        roundAt C p x * roundAt C q y :=
      (mem_residueRepresentatives_iff C).mp ((U).mul_mem
        (roundAt_mem_residueRepresentatives C p x) (roundAt_mem_residueRepresentatives C q y))
    rw [roundAt_eq, ← hpq, wpow_add, ← div_mul_div_comm, ← hxRound, ← hyRound, hprod]
    exact S.mul_mem (hroundx p hp hpfix) (hroundy q hq hqfix)

end Surreal
